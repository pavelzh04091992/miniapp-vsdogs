FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev --ignore-scripts

COPY src/admin ./src/admin
COPY src/db ./src/db

ENV NODE_ENV=production \
    ADMIN_PORT=3000 \
    DB_PATH=/data/auth.sqlite

EXPOSE 3000

CMD ["node", "--experimental-sqlite", "src/admin/server.js"]
