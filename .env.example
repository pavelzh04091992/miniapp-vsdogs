# Local diagnostic gateway. Keep loopback-only on deployed environments.
APP_BIND_ADDRESS=127.0.0.1
LOCAL_APP_PORT=8080
MEDIA_PORT=8081
LOCAL_API_PORT=8787
APP_SERVER_PORT=8787
DATA_PATH=./data
MEDIA_PATH=./media
LETSENCRYPT_PATH=./letsencrypt

# HTTPS routing. A secondary stack reuses the existing proxy network with
# PROXY_NETWORK_EXTERNAL=true and unique Traefik resource names.
DOMAIN=your-domain.example
ACME_EMAIL=your-email@example.com
PROXY_NETWORK_NAME=miniapp-puppys_proxy
PROXY_NETWORK_EXTERNAL=false
TRAEFIK_ENABLE=true
TRAEFIK_ROUTER_NAME=miniapp
TRAEFIK_SERVICE_NAME=miniapp
TRAEFIK_MIDDLEWARE_NAME=miniapp-security-headers

# Locked deployments fail fast when required auth values are missing.
LOCKED_MODE=true
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
# Optional incoming relay. Include docker-compose.webhook-relay.yml only when
# Telegram cannot reach PUBLIC_BASE_URL directly.
TELEGRAM_WEBHOOK_PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_UPSTREAM_HOST=
TRAEFIK_WEBHOOK_RELAY_ROUTER_NAME=miniapp-webhook-relay
WEBHOOK_MAX_BODY_BYTES=1048576
ADMIN_TELEGRAM_ID=
# Telegram ID чата/группы кинологов (или личный Telegram ID для приёма тикетов)
TICKET_CHAT_ID=
# Токен служебного Telegram-бота кинологов (@ticket_centr_bot)
TICKET_BOT_TOKEN=9208966722:AAHw2JkQg4FkBPEPifF1CA5kTLu54thCV1s
BOT_USERNAME=your_bot_username
MINI_APP_URL=https://your-domain.example
PUBLIC_BASE_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=900
TELEGRAM_EGRESS_MODE=direct
TELEGRAM_PROXY_URL=
TRUST_PROXY_HEADERS=true
INVITE_TTL_SECONDS=86400
MAGIC_LINK_TTL_SECONDS=600
BOT_STATE_TTL_SECONDS=600
SUBSCRIPTION_WARNING_SECONDS=259200
SUBSCRIPTION_SWEEP_INTERVAL_SECONDS=300
SESSION_TTL_SECONDS=604800
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=20
MAGIC_LINK_RATE_LIMIT_MAX=30
BOT_COMMAND_RATE_LIMIT_MAX=40
FEEDBACK_RATE_LIMIT_MAX=4
FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=600
SESSION_COOKIE_NAME=__Host-miniapp_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=None
PUBLIC_CHANNEL_USERNAME=your_channel_username
PUBLIC_CHANNEL_ID=-1001234567890
KNOWN_VIDEO_SITUATION_SLUGS=puppy-toilet-home
DEFAULT_VIDEO_SITUATION_SLUG=puppy-toilet-home

# Required by Telegram access control and the Telegram setup/helper scripts.
BOT_TOKEN=
CHANNEL_ID=@your_channel_username
MINI_APP_LINK=https://t.me/testpuppybot/navigation
MESSAGE_TEXT=Откройте mini-app через кнопку ниже.
BUTTON_TEXT=Открыть приложение
PIN_MESSAGE=false
DISABLE_PIN_NOTIFICATION=true
