# Test-prod is served through the production Traefik on HTTPS. Port 8000 is
# intentionally bound to loopback and is only for server-side diagnostics.
APP_BIND_ADDRESS=127.0.0.1
LOCAL_APP_PORT=8000
DATA_PATH=/opt/miniapp-test/data
# Directory that directly contains <video-id>/video.mp4 (no extra media/ level).
MEDIA_PATH=/opt/miniapp/app/media/media

DOMAIN=dev-82-146-52-99.sslip.io
PUBLIC_BASE_URL=https://dev-82-146-52-99.sslip.io
MINI_APP_URL=https://dev-82-146-52-99.sslip.io
ALLOWED_ORIGINS=https://dev-82-146-52-99.sslip.io
PROXY_NETWORK_NAME=miniapp-puppys_proxy
PROXY_NETWORK_EXTERNAL=true
TRAEFIK_ENABLE=true
TRAEFIK_ROUTER_NAME=miniapp-test
TRAEFIK_SERVICE_NAME=miniapp-test
TRAEFIK_MIDDLEWARE_NAME=miniapp-test-security-headers

# Optional temporary SSH egress for Telegram API. The private key and pinned
# known_hosts file live only on the server and are never committed.
TELEGRAM_EGRESS_SSH_HOST=egress.example.com
TELEGRAM_EGRESS_SSH_PORT=22
TELEGRAM_EGRESS_SSH_USER=root
TELEGRAM_EGRESS_TARGET_HOST=api.telegram.org
TELEGRAM_EGRESS_SSH_KEY_PATH=/opt/miniapp-test/secrets/telegram-egress_ed25519
TELEGRAM_EGRESS_KNOWN_HOSTS_PATH=/opt/miniapp-test/secrets/telegram-egress_known_hosts
TELEGRAM_WEBHOOK_PUBLIC_BASE_URL=https://tg-185-250-180-239.sslip.io

LOCKED_MODE=true
ADMIN_TELEGRAM_ID=1358189044
BOT_USERNAME=puppydev1bot
BOT_TOKEN=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_MAX_BODY_BYTES=1048576
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=900
TRUST_PROXY_HEADERS=true

SESSION_COOKIE_NAME=__Host-miniapp_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=None
SESSION_TTL_SECONDS=604800
INVITE_TTL_SECONDS=86400
MAGIC_LINK_TTL_SECONDS=600
BOT_STATE_TTL_SECONDS=600
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=20
MAGIC_LINK_RATE_LIMIT_MAX=30
BOT_COMMAND_RATE_LIMIT_MAX=40

PUBLIC_CHANNEL_ID=
PUBLIC_CHANNEL_USERNAME=
KNOWN_VIDEO_SITUATION_SLUGS=puppy-toilet-home
DEFAULT_VIDEO_SITUATION_SLUG=puppy-toilet-home
