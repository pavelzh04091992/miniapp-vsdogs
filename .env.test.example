# Public test gateway.
TEST_BIND_ADDRESS=0.0.0.0
TEST_PORT=8000

# Use separate writable data and a read-only media source.
TEST_DATA_PATH=./data
TEST_MEDIA_PATH=./media
TEST_HTPASSWD_PATH=./.test-secrets/.htpasswd

# Keep Telegram writes disabled in the test contour.
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
WEBHOOK_MAX_BODY_BYTES=1048576
PUBLIC_CHANNEL_USERNAME=
KNOWN_VIDEO_SITUATION_SLUGS=puppy-toilet-home
DEFAULT_VIDEO_SITUATION_SLUG=puppy-toilet-home
